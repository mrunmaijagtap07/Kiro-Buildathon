# CampusArchive Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_repository
DB_USER=root
DB_PASSWORD=your_mysql_password

# ── File Upload Limits (MB) ────────────────────────────────────────────────────
MAX_REPORT_SIZE_MB=20
MAX_SOURCE_SIZE_MB=50
MAX_DIAGRAM_SIZE_MB=10

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Set Authorized redirect URI to: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# ── Application ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5000

# ── Upload Directories (relative to project root) ─────────────────────────────
UPLOAD_FOLDER=uploads

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_LIFETIME_HOURS=8
